  circle = L.circle([center.lat, center.lng], { radius, color: '#e2c283', weight: 1.5, fillColor: '#e2c283', fillOpacity: .07, interactive: false }).addTo(map);
  map.fitBounds(circle.getBounds(), { padding: [20, 20] });
}
function setCenter(lat, lng, go) { center = { lat, lng }; drawArea(); if (go) runSearch(); }
async function runSearch() {
  if (!center) { say('Escolha um ponto no mapa primeiro.'); return; }
  if (!sel.size) { say('Marque ao menos um tipo de estabelecimento.'); return; }
  const my = ++tok, A = `(around:${radius},${center.lat},${center.lng});`, parts = [];
  sel.forEach(id => {
    const c = CATS[id];
    (c.t || []).forEach(([k, v]) => parts.push(`nwr["${k}"~"${v}"]${A}`));
    if (c.n) parts.push(`nwr["name"~"${c.n}",i]${A}`);
  });
  const q = `[out:json][timeout:25];(${parts.join('')});out center tags 600;`;
  say('Buscando estabelecimentos…'); $('searchBtn').disabled = true;
  let json = null;
  for (const ep of EPS) {
    try {
      const r = await fetch(ep, { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: 'data=' + encodeURIComponent(q) });
      if (!r.ok) throw new Error(r.status);
      json = await r.json(); break;
    } catch (_) {}
  }
  if (my !== tok) return;
  $('searchBtn').disabled = false;
  if (!json) { say('A busca falhou. Tente de novo em instantes ou use um raio menor.'); return; }
  const seen = new Set(); data = [];
  for (const el of json.elements) {
    const key = el.type + el.id;
    if (seen.has(key)) continue; seen.add(key);
    const tags = el.tags || {}, la = el.lat != null ? el.lat : (el.center && el.center.lat), lo = el.lon != null ? el.lon : (el.center && el.center.lon);
    if (la == null) continue;
    const id = [...sel].find(i => match(CATS[i], tags));
    if (id) data.push({ id, name: tags.name || '', tags, lat: la, lng: lo, d: dist(center.lat, center.lng, la, lo) });
  }
  data.sort((a, b) => a.d - b.d);
  renderRes();
}
function popup(x) {
  const t = x.tags, p = phone(t);
  return `<strong>${esc(x.name || 'Sem nome cadastrado')}</strong><br>${CATS[x.id].l}, a ${fmtD(x.d)}` + (addr(t) ? `<br>${esc(addr(t))}` : '') + (p ? `<br>${esc(p)}` : '');
}
function renderRes() {
  const only = $('onlyNoSite').checked;
  shown = data.filter(x => !only || !site(x.tags));
  layer.clearLayers(); markers = [];
  shown.forEach((x, i) => {
    const m = L.marker([x.lat, x.lng], { icon: L.divIcon({ className: '', html: `<span class="pin" style="--c:${CATS[x.id].c}"></span>`, iconSize: [16, 16], iconAnchor: [8, 8] }) }).addTo(layer);
    m.bindPopup(popup(x), { maxWidth: 240 });
    m.on('click', () => focusRes(i));
    markers.push(m);
  });
  const km = radius / 1000;
  $('resCnt').textContent = shown.length ? `${shown.length} estabelecimentos em ${km} km` : '';
  say(shown.length ? `${shown.length} encontrados em ${km} km. Toque em outro ponto para refazer a busca.` : `Nada encontrado em ${km} km com esses filtros. Aumente o raio ou marque outros tipos.`);
  $('results').innerHTML = shown.map((x, i) => {
    const c = CATS[x.id], t = x.tags, p = phone(t), s = site(t), a = addr(t);
    return `<article class="res" id="r${i}" style="--c:${c.c}" data-i="${i}">
      <div class="res-h"><h4>${esc(x.name || 'Sem nome cadastrado')}</h4><span class="dist">${fmtD(x.d)}</span></div>
      <div class="res-m"><b>${c.l}</b>${a ? ' | ' + esc(a) : ''}</div>
      <div class="res-a">${p ? `<a href="tel:${esc(p)}">Ligar</a><a target="_blank" rel="noopener" href="https://wa.me/${wa(p)}">WhatsApp</a>` : ''}
      ${s ? `<a target="_blank" rel="noopener" href="${url(s)}">Site</a>` : '<span class="tagx">sem site</span>'}
      <a target="_blank" rel="noopener" href="https://www.google.com/maps/dir/?api=1&destination=${x.lat},${x.lng}">Rota</a></div></article>`;
  }).join('');
}
function focusRes(i) {
  document.querySelectorAll('.res.hl').forEach(e => e.classList.remove('hl'));
  const el = $('r' + i); if (el) { el.classList.add('hl'); el.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
}
function later() { clearTimeout(timer); if (center) timer = setTimeout(runSearch, 700); }
$('results').onclick = e => {
  if (e.target.closest('a')) return;
  const r = e.target.closest('.res'); if (!r) return;
  const i = +r.dataset.i; map.setView([shown[i].lat, shown[i].lng], Math.max(map.getZoom(), 17));
  markers[i].openPopup(); $('map').scrollIntoView({ behavior: 'smooth', block: 'center' });
};
$('cats').onclick = e => {
  const b = e.target.closest('.chip'); if (!b) return;
  sel.has(b.dataset.id) ? sel.delete(b.dataset.id) : sel.add(b.dataset.id);
  b.classList.toggle('on'); later();
};
$('catAll').onclick = () => { Object.keys(CATS).forEach(k => sel.add(k)); renderCats(); later(); };
$('catNone').onclick = () => { sel.clear(); renderCats(); };
$('radius').onclick = e => {
  const b = e.target.closest('button'); if (!b) return;
  radius = +b.dataset.r;
  document.querySelectorAll('#radius button').forEach(x => x.classList.toggle('on', x === b));
  drawArea(); later();
};
$('onlyNoSite').onchange = () => { if (map && data.length) renderRes(); };
$('searchBtn').onclick = () => { initMap(); runSearch(); };
$('geoBtn').onclick = () => {
  initMap();
  if (!navigator.geolocation) { say('Seu navegador não permite localização. Toque no mapa.'); return; }
  say('Obtendo sua localização…');
  navigator.geolocation.getCurrentPosition(
    p => setCenter(p.coords.latitude, p.coords.longitude, true),
    () => say('Não consegui sua localização. Permita o acesso no navegador ou toque no mapa.'),
    { enableHighAccuracy: true, timeout: 10000 });
};
async function findAddr() {
  const v = $('addr').value.trim(); if (!v) return;
  initMap(); say('Procurando endereço…');
  try {
    const r = await fetch('https://nominatim.openstreetmap.org/search?format=json&limit=1&countrycodes=br&q=' + encodeURIComponent(v));
    const j = await r.json();
    if (!j.length) { say('Endereço não encontrado. Tente incluir a cidade.'); return; }
    setCenter(+j[0].lat, +j[0].lon, true);
  } catch (_) { say('Não foi possível buscar o endereço agora. Toque direto no mapa.'); }
}
$('addrGo').onclick = findAddr;
$('addr').onkeydown = e => { if (e.key === 'Enter') findAddr(); };
$('csvBtn').onclick = () => {
  if (!shown.length) { say('Faça uma busca antes de baixar o CSV.'); return; }
  const q = v => '"' + String(v == null ? '' : v).replace(/"/g, '""') + '"';
  const rows = [['Nome','Tipo','Distancia (m)','Endereco','Telefone','Site','Latitude','Longitude'].map(q).join(',')]
    .concat(shown.map(x => [x.name, CATS[x.id].l, Math.round(x.d), addr(x.tags), phone(x.tags), site(x.tags), x.lat, x.lng].map(q).join(',')));
  const a = document.createElement('a');
  a.href = URL.createObjectURL(new Blob(['\ufeff' + rows.join('\n')], { type: 'text/csv;charset=utf-8' }));
  a.download = 'negocios-' + radius / 1000 + 'km.csv'; a.click(); URL.revokeObjectURL(a.href);
};
const _goTo = goTo;
goTo = function (id) { _goTo(id); if (id === 'mapa') initMap(); };
renderCats();
 
